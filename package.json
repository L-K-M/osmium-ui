{
  "name": "osmium-ui",
  "version": "0.3.1",
  "description": "A pixel-exact recreation of the Mac OS 8 look for web pages and WKWebView apps: windows, controls, bitmap fonts and a native macOS window host.",
  "license": "Unlicense",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/L-K-M/osmium-ui.git"
  },
  "keywords": [
    "mac-os-8",
    "retro",
    "ui",
    "widgets",
    "pixel-art",
    "wkwebview"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./osmium.css": "./osmium.css"
  },
  "types": "./src/index.ts",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "osmium.css",
    "macos",
    "Package.swift",
    "NOTICE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:build": "node demo/build.mjs",
    "demo": "node demo/build.mjs --serve"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
